# Storage Provider: "local" | "vercel-blob" | "railway-volume"
STORAGE_PROVIDER=local

# Public base URL (used for local/railway storage to construct image URLs)
PUBLIC_BASE_URL=http://localhost:3000

# Local filesystem upload directory (for local dev)
LOCAL_UPLOAD_DIR=

# Railway volume path (for Railway deployment)
RAILWAY_VOLUME_PATH=/data/uploads

# Vercel Blob (automatically available on Vercel when @vercel/blob is installed)
# BLOB_READ_WRITE_TOKEN=

# Upload limits
MAX_FILE_SIZE_MB=10
MAX_FILES_PER_UPLOAD=50
MAX_TOTAL_UPLOAD_MB=100

# Retention
RETENTION_DAYS=2

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=10
RATE_LIMIT_MAX_REQUESTS=30
DAILY_UPLOAD_LIMIT=200

# Cron cleanup secret (optional - set to protect /api/cleanup endpoint)
# CRON_SECRET=

# Supabase (pre-populated automatically)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
